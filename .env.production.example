# Production env template — copy to .env (never commit secrets)

# Auth SQL backend (SQLite on EFS in AWS, or Postgres)
USE_DB_AUTH=1
AUTH_SQLITE_PATH=/data/auth.db
# Optional post-deploy bootstrap (not committed with real passwords)
# BOOTSTRAP_SUPER_EMAIL=ops@citealpha.com
# BOOTSTRAP_SUPER_PASSWORD=change-me

FORCE_HTTPS=1
ENABLE_HSTS=1
INTELLENS_PUBLIC_URL=https://citealpha.com

# Rotate these
INTELLENS_API_KEY=replace-me
INTELLENS_ABUSE_SECRET=replace-me
INTELLENS_AUTH_DEV_TOKENS=0
INTELLENS_ABUSE_OFF=0

# Counsel gates (or use POST /api/legal/attest with admin key)
INTELLENS_LEGAL_COUNSEL_STATUS=counsel_approved
INTELLENS_RETAIL_MARKETING=true

# SSO
SSO=true
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_REDIRECT_URI=https://citealpha.com/api/auth/sso/callback

# Mail (verify / reset / invites) — wired into ECS via aws-deploy.sh
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CiteAlpha <no-reply@citealpha.com>
# INTELLENS_AUTH_DEV_TOKENS=0

AUTH_RATE_LIMIT_RPM=20
RATE_LIMIT_RPM=120
RETAIL_PRICE_INR=4999

# GCI scorer (v3 = exp δ / recency default; v2 = legacy heuristic)
INTELLENS_GCI_VERSION=v3

# LLM extract + Research embeddings (leave empty → heuristic / TF-IDF)
# Real key only in runtime secrets / ECS — never commit.
# Gemini (OpenAI-compat): https://aistudio.google.com/apikey
# OPENAI_API_KEY=
# INTELLENS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# INTELLENS_LLM_MODEL=gemini-2.0-flash
# INTELLENS_EMBED_MODEL=text-embedding-004
# INTELLENS_LLM_EXTRACT=true
# INTELLENS_EMBEDDINGS=true

# Billing: set BILLING_DEMO=1 only for non-prod UPI stub confirms
# BILLING_DEMO=0

# --- Portfolio SKUs (Radar / Ledger / stretch) — wired into ECS via aws-deploy.sh ---
RADAR_DIGEST=1
IR_MIRROR=1
PORTFOLIO_STRETCH=1
SIGHTS=1
SIGHTS_DEEP_DIVE=1
SIGHTS_GRID=1
SIGHTS_AGENTS=1
SIGHTS_WEB_ASSIST=0
VITE_GA_MEASUREMENT_ID=G-EZZ5NWY1QC
VITE_GSC_VERIFICATION=replace-me
VITE_PLAUSIBLE_DOMAIN=www.citealpha.com

SMTP_HOST=...
SMTP_PORT=587
SMTP_FROM=noreply@citealpha.com
SMTP_USER=...
SMTP_PASS=...
PILOT_REQUEST_TO=dk@citealpha.com

DEFAULT_LANGUAGE=en


# --- Frontend build (Vite — baked into static bundle at docker build) ---
# VITE_PLAUSIBLE_DOMAIN=citealpha.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GSC_VERIFICATION=your-google-search-console-token
