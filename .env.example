# IntelLens local secrets — copy to backend/.env or repo .env (gitignored)
# NEVER commit real keys.

# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs/quickstart
# Add ?apikey=... is handled by the client; set the value here only.
INTELLENS_FMP_API_KEY=

# Live GCI refresh every 6 hours (scheduler / cron)
INTELLENS_REFRESH_HOURS=6
INTELLENS_CRAWL_LIVE=1
INTELLENS_AUTO_EXTRACT_ON_REFRESH=1
INTELLENS_WARM_FMP_ON_REFRESH=1

# Feature flags (optional)
# RESEARCH_LLM=false
# SSO=false
# CONSENSUS_IMPORT=true
