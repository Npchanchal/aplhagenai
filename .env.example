# IntelLens local secrets — copy to backend/.env or repo .env (gitignored)
# NEVER commit real keys.

# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs/quickstart
INTELLENS_FMP_API_KEY=

# Live GCI refresh every 6 hours (scheduler / cron)
INTELLENS_REFRESH_HOURS=6
INTELLENS_CRAWL_LIVE=1
INTELLENS_AUTO_EXTRACT_ON_REFRESH=1
INTELLENS_WARM_FMP_ON_REFRESH=1

# --- Production OIDC (Google / Azure AD / Okta / Keycloak) ---
# SSO=true
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://accounts.google.com
# OIDC_REDIRECT_URI=https://ocotilloinnovation.in/api/auth/sso/callback
# Optional overrides:
# OIDC_DISCOVERY_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPE=openid email profile
# OIDC_DEMO_ASSERT=false

# --- Live AlphaHunter / facts connector ---
# ALPHAHUNTER_API_URL=https://vendor.example/api/facts
# ALPHAHUNTER_API_KEY=
# (aliases: FACTS_API_URL / FACTS_API_KEY)

# CSM contact shown in Desk
# CSM_EMAIL=csm@yourfirm.com

# Feature flags (optional)
# RESEARCH_LLM=false
# CONSENSUS_IMPORT=true
# ALLOW_DEMO_STREET=false
# VPC_DEPLOY=false
