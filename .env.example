# CiteAlpha local secrets — copy to repo `.env` or `backend/.env` (gitignored)
# NEVER commit real keys.

# Financial Modeling Prep — https://site.financialmodelingprep.com/developer/docs/quickstart
INTELLENS_FMP_API_KEY=

# Live GCI refresh every 6 hours (scheduler / cron)
INTELLENS_REFRESH_HOURS=6
INTELLENS_CRAWL_LIVE=1
INTELLENS_AUTO_EXTRACT_ON_REFRESH=1
INTELLENS_WARM_FMP_ON_REFRESH=1

# --- Auth (SQLite locally; EFS-backed SQLite or Postgres on AWS) ---
# USE_DB_AUTH=1
# AUTH_SQLITE_PATH=/data/auth.db
# USE_POSTGRES_AUTH=1
# DATABASE_URL=postgresql://user:pass@localhost:5432/citealpha
# BOOTSTRAP_SUPER_EMAIL=ops@citealpha.com
# BOOTSTRAP_SUPER_PASSWORD=change-me
# INTELLENS_API_KEY=replace-me
# INTELLENS_ABUSE_SECRET=replace-me
# INTELLENS_AUTH_DEV_TOKENS=0

# --- Mail (verify / reset / invites) ---
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=CiteAlpha <no-reply@citealpha.com>
# PILOT_REQUEST_TO=sales@citealpha.com

# --- Production OIDC (Google / Azure AD / Okta / Keycloak) ---
# SSO=true
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://accounts.google.com
# OIDC_REDIRECT_URI=https://citealpha.com/api/auth/sso/callback
# Optional overrides:
# OIDC_DISCOVERY_URL=
# OIDC_TOKEN_URL=
# OIDC_USERINFO_URL=
# OIDC_SCOPE=openid email profile
# OIDC_DEMO_ASSERT=false

# --- HTTPS / public URL (ECS via aws-deploy TF_VAR_*) ---
# FORCE_HTTPS=1
# ENABLE_HSTS=1
# INTELLENS_PUBLIC_URL=https://citealpha.com

# --- Live AlphaHunter / facts connector ---
# ALPHAHUNTER_API_URL=https://vendor.example/api/facts
# ALPHAHUNTER_API_KEY=
# (aliases: FACTS_API_URL / FACTS_API_KEY)

# CSM contact shown in Desk
# CSM_EMAIL=csm@yourfirm.com

# Feature flags (optional)
# INTELLENS_GCI_VERSION=v3   # default: v3 exp engine; set v2 for legacy heuristic
# RESEARCH_LLM=false         # optional cite-only answer rewrite (still refuses without cites)
# CONSENSUS_IMPORT=true
# ALLOW_DEMO_STREET=false
# BILLING_DEMO=0             # allow upi-demo confirm only when 1
# VPC_DEPLOY=false
# DEFAULT_LANGUAGE=en

# --- LLM extract + Research embeddings (OpenAI-compatible) ---
# Put the real key only in gitignored `.env` — never in this file.
# OpenAI: leave BASE_URL unset (defaults to https://api.openai.com/v1)
# OPENAI_API_KEY=
# INTELLENS_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# INTELLENS_LLM_MODEL=gemini-2.0-flash
# INTELLENS_EMBED_MODEL=text-embedding-004
# INTELLENS_LLM_EXTRACT=true
# INTELLENS_EMBEDDINGS=true
# OpenAI defaults if BASE_URL unset:
# INTELLENS_LLM_MODEL=gpt-4o-mini
# INTELLENS_EMBED_MODEL=text-embedding-3-small

# --- Translation (i18n UI copy; separate from GCI extract) ---
# TRANSLATION_PROVIDER=openai
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Frontend analytics / Search Console (local Vite dev; production via Docker build args) ---
# VITE_PLAUSIBLE_DOMAIN=citealpha.com
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GSC_VERIFICATION=your-google-search-console-token
# VITE_BING_VERIFICATION=your-bing-webmaster-msvalidate-token
# VITE_TWITTER_SITE=citealpha
# Optional org social profiles for Organization.sameAs — edit frontend/src/lib/seo-structured-data.json
# "socialProfiles": ["https://www.linkedin.com/company/...", "https://x.com/..."]

# --- Portfolio SKUs (Radar / Ledger / stretch) ---
# RADAR_DIGEST=1          # enable POST /api/radar/digest/send + webhooks (ECS via aws-deploy.sh)
# IR_MIRROR=1             # enable GET /api/ledger/mirror/{id}
# PORTFOLIO_STRETCH=1     # NCI + extraction workbench endpoints
# SIGHTS=1                # CiteAlpha Sights shell (default on)
# SIGHTS_DEEP_DIVE=1
# SIGHTS_GRID=1
# SIGHTS_AGENTS=1
# SIGHTS_WEB_ASSIST=0     # open-web assist — off until quality gates
