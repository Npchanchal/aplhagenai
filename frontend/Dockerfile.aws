# AWS Fargate image: SPA + reverse-proxy to co-located API on 127.0.0.1:8000 (no ALB).
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE=
ARG VITE_PLAUSIBLE_DOMAIN=
ARG VITE_GA_MEASUREMENT_ID=
ARG VITE_GSC_VERIFICATION=
ARG VITE_BING_VERIFICATION=
ARG VITE_TWITTER_SITE=
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_PLAUSIBLE_DOMAIN=$VITE_PLAUSIBLE_DOMAIN
ENV VITE_GA_MEASUREMENT_ID=$VITE_GA_MEASUREMENT_ID
ENV VITE_GSC_VERIFICATION=$VITE_GSC_VERIFICATION
ENV VITE_BING_VERIFICATION=$VITE_BING_VERIFICATION
ENV VITE_TWITTER_SITE=$VITE_TWITTER_SITE
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.fargate.conf /etc/nginx/conf.d/default.conf
COPY nginx.static.conf /etc/nginx/snippets/static-cache.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
